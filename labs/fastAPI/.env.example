## Formato: dialect+driver://usuario:senha@host:porta/banco
DATABASE_URL=postgresql+asyncpg://myuser:secret@postgres:5432/mydatabase
DB_NAME=mydatabase
DB_USERNAME=myuser
DB_PASSWORD=secret
# Porta exposta para o seu computador (se a porta 5432 já estiver ocupada na sua máquina, altere para 5433)
DB_PORT=5432